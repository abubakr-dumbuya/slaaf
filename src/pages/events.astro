---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import flagTag from '../assets/photos/flag-tag.jpg';
import { fetchUpcoming, linkify } from '../lib/calendar';

// Read live so a newly added event appears without a rebuild.
export const prerender = false;

// SLAAF's public calendar. Public calendar IDs are not secrets — they appear
// in every embed URL — so this is a default rather than a required env var.
const DEFAULT_CALENDAR_ID =
  'd70c6bb1623ca7cce65ebaa41ac643e3ebed78265bae6e9a7618684894aa6e86@group.calendar.google.com';

const calendarId = import.meta.env.GOOGLE_CALENDAR_ID || DEFAULT_CALENDAR_ID;
const feedUrl = import.meta.env.CALENDAR_ICS_URL;
const events = calendarId ? await fetchUpcoming(calendarId, feedUrl) : null;

// Events span Freetown, Europe and the US, so each is shown in the zone it was
// scheduled in — an event at 20:30 in Seattle should read 20:30, not 03:30.
// Events exported without one fall back to the calendar's own zone.
const FALLBACK_TZ = 'Africa/Freetown';
const zoneOf = (event: { timeZone: string | null; allDay: boolean }) =>
  event.allDay ? 'UTC' : (event.timeZone ?? FALLBACK_TZ);

const fmt = (timeZone: string, options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-GB', { ...options, timeZone });

const dayFmt = (tz: string) => fmt(tz, { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
const timeFmt = (tz: string) => fmt(tz, { hour: '2-digit', minute: '2-digit' });
const zoneFmt = (tz: string) => fmt(tz, { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
/** The badge reads as one line: "1 AUG 2027", uppercased by .type-label. */
const badgeFmt = (tz: string) => fmt(tz, { day: 'numeric', month: 'short', year: 'numeric' });

const DAY_MS = 86_400_000;

/**
 * An all-day DTEND is exclusive in iCalendar: an event ending "31 July" runs
 * to the 30th. Step back a day to get the last day people actually attend.
 */
const lastDayOf = (event: { end: Date | null; start: Date }) => {
  if (!event.end) return null;
  const last = new Date(event.end.valueOf() - DAY_MS);
  return last.valueOf() > event.start.valueOf() ? last : null;
};

/** "GMT", "PDT" — the trailing token of a short-zone format. */
const zoneLabel = (date: Date, tz: string) =>
  zoneFmt(tz).formatToParts(date).find((p) => p.type === 'timeZoneName')?.value ?? '';
---
<Base
  title="Upcoming events"
  description="Combines, trials, training sessions and fixtures from the Sierra Leone Authority of American Football."
  headerOverlay
>
  <PhotoHero
    photo={flagTag}
    alt="A SLAAF player reaching for an opponent's flag during a flag football game in Freetown"
    position="center 45%"
  >
    <h1 class="hero-title">Upcoming events</h1>
  </PhotoHero>

  <section class="border-b border-ink-900/10 bg-sand-100">
    <div class="container-page py-10">
      <p class="prose-body">
        Everything coming up — combines, trials, fixtures and gatherings. Times
        are shown in your local time.
      </p>
    </div>
  </section>

  <section class="container-page py-16">
    {events && events.length > 0 && (
      <ul class="space-y-px overflow-hidden rounded-2xl bg-ink-900/10">
        {events.map((event) => (
          <li class="bg-sand-100 p-6 sm:p-8">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
              {/* Width follows the text rather than being fixed: with the year
                  on the same line the old 6rem chip could not hold it. */}
              <div
                class="flex shrink-0 items-center justify-center self-start rounded-xl bg-ink-950 px-5 py-3 text-white"
                data-badge
                data-start={event.start.toISOString()}
                data-all-day={String(event.allDay)}
              >
                <span class="type-label whitespace-nowrap" data-badge-date>
                  {badgeFmt(zoneOf(event)).format(event.start)}
                </span>
              </div>

              <div class="min-w-0">
                <h2 class="text-2xl">{event.summary}</h2>
                <p
                  class="mt-2 text-ink-700"
                  data-when
                  data-start={event.start.toISOString()}
                  data-end={event.end ? event.end.toISOString() : ''}
                  data-all-day={String(event.allDay)}
                >
                  <time datetime={event.start.toISOString()}>{dayFmt(zoneOf(event)).format(event.start)}</time>
                  {!event.allDay && (
                    <span>
                      {' · '}{timeFmt(zoneOf(event)).format(event.start)}
                      {event.end && ` – ${timeFmt(zoneOf(event)).format(event.end)}`}
                      {' '}<span class="text-ink-500">{zoneLabel(event.start, zoneOf(event))}</span>
                    </span>
                  )}
                  {event.allDay && (
                    lastDayOf(event)
                      ? <span> – <time datetime={lastDayOf(event)!.toISOString()}>{dayFmt(zoneOf(event)).format(lastDayOf(event)!)}</time></span>
                      : <span> · All day</span>
                  )}
                </p>
                {event.location && <p class="mt-1 text-ink-600">{event.location}</p>}
                {event.description && (
                  <p class="mt-4 whitespace-pre-line leading-relaxed text-ink-700">
                    {linkify(event.description).map((part) =>
                      part.href ? (
                        <a href={part.href} class="text-leone-700 underline break-words"
                           target="_blank" rel="noopener noreferrer">{part.text}</a>
                      ) : (
                        part.text
                      ),
                    )}
                  </p>
                )}

                <p class="mt-5">
                  <a
                    href={`/events/${encodeURIComponent(event.uid)}.ics`}
                    class="type-label inline-flex items-center gap-2 text-leone-700 underline underline-offset-4 hover:text-leone-800"
                  >
                    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M8 2v8m0 0L5 7m3 3 3-3M3 12v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1"
                            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Add to calendar
                  </a>
                </p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}

    {events && events.length === 0 && (
      <p class="prose-body">No upcoming events.</p>
    )}

    {events === null && (
      <p class="prose-body">
        Events could not be loaded just now. Please try again shortly.
      </p>
    )}

  </section>


</Base>

<script>
  /**
   * The server renders each event in the zone it was scheduled in, which is
   * correct but not local to whoever is reading. Once JavaScript runs, rewrite
   * the times in the visitor's own zone so a session in Freetown and a
   * fundraiser in Seattle each read at the hour that visitor will experience.
   *
   * Without JavaScript the server-rendered times stand, so the page is never
   * blank or wrong — just expressed in the organiser's zone instead.
   *
   * All-day events are dates, not instants, and are left alone: shifting them
   * by a timezone would move an event to the wrong day.
   */
  const weekdayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short' });
  const restFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  const formatDay = (d: Date) => `${weekdayFmt.format(d)}, ${restFmt.format(d)}`;

  // All-day values are calendar dates held at UTC midnight. Formatting them in
  // the viewer's zone would shift them a day for anyone west of UTC.
  const utcWeekdayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'UTC' });
  const utcRestFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const formatDayUtc = (d: Date) => `${utcWeekdayFmt.format(d)}, ${utcRestFmt.format(d)}`;
  const timeFmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit' });
  const zoneFmt = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
  });
  const badgeFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  const zoneOf = (d: Date) =>
    zoneFmt.formatToParts(d).find((p) => p.type === 'timeZoneName')?.value ?? '';

  document.querySelectorAll<HTMLElement>('[data-badge]').forEach((el) => {
    if (el.dataset.allDay === 'true') return;
    const start = new Date(el.dataset.start!);
    if (Number.isNaN(start.valueOf())) return;
    el.querySelector<HTMLElement>('[data-badge-date]')!.textContent = badgeFmt.format(start);
  });

  const DAY_MS = 86_400_000;

  document.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => {
    if (el.dataset.allDay === 'true') {
      // All-day DTEND is exclusive: an event ending "31 July" runs to the 30th.
      const from = new Date(el.dataset.start!);
      const rawEnd = el.dataset.end ? new Date(el.dataset.end) : null;
      if (!rawEnd || Number.isNaN(rawEnd.valueOf())) return;
      const to = new Date(rawEnd.valueOf() - DAY_MS);
      if (to.valueOf() <= from.valueOf()) return;

      const start = document.createElement('time');
      start.dateTime = from.toISOString();
      start.textContent = formatDayUtc(from);
      const end = document.createElement('time');
      end.dateTime = to.toISOString();
      end.textContent = formatDayUtc(to);
      el.replaceChildren(start, document.createTextNode(' – '), end);
      return;
    }
    const start = new Date(el.dataset.start!);
    if (Number.isNaN(start.valueOf())) return;
    const end = el.dataset.end ? new Date(el.dataset.end) : null;

    const time = document.createElement('time');
    time.dateTime = start.toISOString();
    time.textContent = formatDay(start);

    const rest = document.createElement('span');
    const zone = document.createElement('span');
    zone.className = 'text-ink-500';
    zone.textContent = zoneOf(start);
    const range = end && !Number.isNaN(end.valueOf())
      ? `${timeFmt.format(start)} – ${timeFmt.format(end)} `
      : `${timeFmt.format(start)} `;
    rest.append(document.createTextNode(` · ${range}`), zone);

    el.replaceChildren(time, rest);
  });
</script>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base
  title="News"
  description="Official news and announcements from the Sierra Leone Authority of American Football."
>
  <PageHeader title="News" lede="Announcements, match reports and updates from the Authority." />

  {posts.length === 0 ? (
    <Placeholder need="No posts published yet. News articles are Markdown files in src/content/news/ — see CONTENT.md for how to add one." />
  ) : (
    <div class="container-page py-16">
      <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <a href={`/news/${post.id}/`} class="group block">
              <time datetime={post.data.date.toISOString()} class="type-label text-ink-500">
                {fmt.format(post.data.date)}
              </time>
              <h2 class="mt-3 text-xl transition group-hover:text-leone-600">{post.data.title}</h2>
              <p class="mt-2 leading-relaxed text-ink-700">{post.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</Base>

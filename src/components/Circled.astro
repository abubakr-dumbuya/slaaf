---
/**
 * Wraps a word in a hand-drawn marker ellipse — the device used on the
 * slaaf.org holding page ("SALONE (GRIDIRON) LOADING").
 * The stroke overshoots its start point so it reads as drawn, not geometric.
 */
interface Props {
  color?: string;
  class?: string;
}
const { color = 'text-leone-500', class: className = '' } = Astro.props;
---
<span class:list={['relative inline-block whitespace-nowrap', className]}>
  <span class="relative z-10"><slot /></span>
  <svg
    class:list={['pointer-events-none absolute inset-x-[-3.5%] inset-y-[-15%] h-[130%] w-[107%]', color]}
    viewBox="0 0 200 60"
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M172 13C150 3 92 -1 52 6 16 12 1 27 6 38c5 12 40 20 92 19 46-1 88-9 98-22 7-9 1-18-16-24"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>
</span>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import RegistrationForm from '../components/RegistrationForm.astro';

// Written once. Shown under the lede on mobile and tablet, and in the sidebar
// from lg up, where there is a column to hold it.
const notes = [
  "Open to anyone 15 or over with a connection to Sierra Leone — by birth, or through a parent or grandparent — wherever you live.",
  "No experience of American football needed. Under 18s will need a parent or guardian's details.",
  "Registrations go onto SLAAF's database: how we select for combines, training and squads, and how we staff events. We reply by email.",
];

---
<Base
  title="Get involved"
  description="Play, coach, officiate or volunteer with the Sierra Leone Authority of American Football — open to Sierra Leoneans at home and anywhere in the world."
>
  <PageHeader
    title="Get involved"
    lede="We need players, coaches, officials and volunteers — in Sierra Leone and across the diaspora."
  >
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {notes.map((note) => (
        <p class="border-t-2 border-ink-900/15 pt-4 leading-relaxed text-ink-700">{note}</p>
      ))}
    </div>
  </PageHeader>

  <section class="container-page py-16">
    <h2 class="text-3xl sm:text-4xl">Register your interest</h2>
    <p class="prose-body mt-5 max-w-2xl">
      No commitment at this stage — it just tells us who you are and what you
      want to do.
    </p>


    <RegistrationForm />
  </section>

  <Placeholder need="Still to confirm for this page: eligibility rules for heritage players and any documentation required, the calendar of combines and trials, the positions being actively recruited, and where registration data should be delivered (the form is built but not yet connected to a destination)." />
</Base>

---
import Base from '../layouts/Base.astro';

const ways = [
  { title: 'Play', body: 'Combines, trials and national squads — flag and tackle, men and women.' },
  { title: 'Coach', body: 'Get certified and lead training in schools, clubs and communities.' },
  { title: 'Officiate', body: 'Train as a referee or official and run the game on match day.' },
  { title: 'Volunteer', body: 'Events, logistics, media, kit — everything that happens off the field.' },
];

const pillars = [
  {
    title: 'Grow the game at home',
    body: 'Introducing tackle and flag football to schools, universities and communities across Sierra Leone — coaching, equipment and safe places to play.',
  },
  {
    title: 'Build national teams',
    body: 'Selecting and preparing squads to represent Sierra Leone in international flag and tackle competition.',
  },
  {
    title: 'Govern the sport',
    body: 'Acting as the national governing body: registering clubs, certifying coaches and officials, and upholding player-safety standards.',
  },
];
---
<Base
  title="Sierra Leone Authority of American Football"
  description="Sierra Leone Authority of American Football (SLAAF) — the national governing body for tackle and flag football, building the game at home and across the diaspora."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
      <h1 class="text-5xl leading-[0.92] sm:text-7xl lg:text-8xl">
        Salone Gridiron
        <span class="mt-2 block text-atlantic-600">is here.</span>
      </h1>

      <p class="prose-body mt-8">
        Sierra Leone Authority of American Football (SLAAF) is the national
        governing body for American football in Sierra Leone. We are building the
        game from the ground up — in schools and communities at home, and with
        Sierra Leonean talent wherever in the world it is found.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/get-involved" class="btn btn-primary">Get involved</a>
        <a href="/apparel" class="btn btn-secondary">Shop the collection</a>
      </div>
    </div>
  </section>

  <!-- Ways to get involved -->
  <section class="border-y border-ink-900/10 bg-sand-100">
    <div class="container-page py-20">
      <h2 class="text-3xl sm:text-4xl">Ways you can get involved</h2>
      <p class="prose-body mt-4 max-w-2xl">
        You do not have to be a player, and you do not have to be in Sierra Leone.
      </p>

      <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {ways.map((way) => (
          <li>
            <a
              href="/get-involved"
              class="group block border-t-4 border-leone-500 pt-5 transition hover:border-atlantic-600"
            >
              <h3 class="text-xl transition group-hover:text-atlantic-600">{way.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-700">{way.body}</p>
              <span class="type-label mt-4 inline-flex items-center gap-1 text-leone-600 transition group-hover:text-atlantic-600">
                Register
                <svg class="h-3 w-3 transition-transform group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What we do -->
  <section>
    <div class="container-page py-20">
      <h2 class="text-3xl sm:text-4xl">What the Authority does</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {pillars.map((p, i) => (
          <div>
            <p class="type-numeral text-5xl text-leone-500/30">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-xl">{p.title}</h3>
            <p class="mt-3 text-ink-700 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-atlantic-600 text-white">
    <div class="container-page py-20 text-center">
      <h2 class="text-5xl sm:text-7xl">Kam join wi</h2>
      <p class="mx-auto mt-6 max-w-xl text-lg text-white/90">
        Players, coaches, officials, volunteers and partners — there is a place
        for you in Sierra Leone&rsquo;s football story.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/get-involved" class="btn bg-white text-atlantic-700 hover:bg-sand-100">Get involved</a>
        <a href="mailto:info@slaaf.org" class="btn border-2 border-white/50 text-white hover:border-white">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

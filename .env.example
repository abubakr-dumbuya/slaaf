# Where player registrations are delivered.
# With none of these set, the registration endpoint returns 503 and /play shows
# a "not yet open" notice rather than accepting submissions it cannot store.

# Transactional email (current setup). This is the only required variable —
# registrations are emailed to info@slaaf.org by default.
RESEND_API_KEY=

# Optional overrides.
# SLAAF_NOTIFY_EMAIL=info@slaaf.org
# SLAAF_FROM_EMAIL=SLAAF Registrations <registrations@slaaf.org>

# Alternative: POST each registration as JSON to a URL instead of emailing
# (e.g. a Google Apps Script that appends to a Sheet). Takes precedence.
# SLAAF_WEBHOOK_URL=

# Upcoming events are read from a public Google Calendar's iCalendar feed and
# rendered natively. Set this to the calendar's ID (Settings > Integrate
# calendar > Calendar ID) and make sure the calendar is public.
GOOGLE_CALENDAR_ID=

# Optional: read from a different iCalendar feed instead of Google's.
# CALENDAR_ICS_URL=

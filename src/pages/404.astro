---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page could not be found.">
  <div class="container-page py-32 text-center">
    <p class="type-numeral text-8xl text-leone-500/30">404</p>
    <h1 class="mt-4 text-4xl">Incomplete pass</h1>
    <p class="prose-body mx-auto mt-4 max-w-md">That page could not be found.</p>
    <a href="/" class="btn btn-primary mt-10">Back to the home page</a>
  </div>
</Base>

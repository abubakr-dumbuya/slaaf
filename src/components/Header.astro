---
import { Image } from 'astro:assets';
import logo from '../assets/slaaf-logo.png';

interface Props {
  /**
   * Sit transparently over a photographic hero, then swap to the sand bar once
   * the page scrolls. Fixed rather than sticky: sticky would occupy flow and
   * push the hero down instead of laying over it.
   */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const nav = [
  { href: '/get-involved', label: 'Get involved' },
  { href: '/events', label: 'Events' },
  { href: '/apparel', label: 'Apparel' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---
<header
  data-overlay-header={overlay ? '' : undefined}
  class:list={[
    'group z-50 transition-colors duration-300',
    overlay
      ? 'fixed inset-x-0 top-0 data-scrolled:border-b data-scrolled:border-ink-900/10 data-scrolled:bg-sand-200/90 data-scrolled:backdrop-blur'
      : 'sticky top-0 border-b border-ink-900/10 bg-sand-200/90 backdrop-blur',
  ]}
>
  <div class="container-page flex items-center justify-between gap-6 py-3">
    <a href="/" class="shrink-0" aria-label="Sierra Leone Authority of American Football — home">
      <Image
        src={logo}
        alt="Sierra Leone Authority of American Football"
        height={56}
        densities={[1, 2]}
        class:list={[
          'h-11 w-auto transition duration-300 sm:h-14',
          overlay && 'brightness-0 invert group-data-scrolled:brightness-100 group-data-scrolled:invert-0',
        ]}
      />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
              class:list={[
                'type-control whitespace-nowrap transition',
                overlay
                  ? 'text-white hover:text-leone-300 group-data-scrolled:text-ink-800 group-data-scrolled:hover:text-leone-600'
                  : 'hover:text-leone-600',
                !overlay && (path.startsWith(item.href) ? 'text-leone-600' : 'text-ink-800'),
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="lg:hidden [&_svg]:open:rotate-90">
      <summary
        class:list={[
          'type-control flex cursor-pointer items-center gap-2 rounded-full border-2 px-4 py-2 transition',
          overlay
            ? 'border-white/50 text-white group-data-scrolled:border-ink-900/20 group-data-scrolled:text-ink-900'
            : 'border-ink-900/20',
        ]}
      >
        Menu
        <svg class="h-3 w-3 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </summary>
      <nav aria-label="Primary mobile" class="absolute inset-x-0 top-full border-b border-ink-900/10 bg-sand-100 shadow-lg">
        <ul class="container-page flex flex-col py-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="type-control block border-b border-ink-900/5 py-3">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

{overlay && (
  <script>
    // The sentinel is a strip at the very top of the document. Once it leaves
    // the viewport the header has travelled off the hero, so it takes the sand
    // bar. An observer rather than a scroll handler: no work on every frame.
    const header = document.querySelector('[data-overlay-header]');
    const sentinel = document.querySelector('[data-header-sentinel]');
    if (header && sentinel) {
      new IntersectionObserver(
        ([entry]) => header.toggleAttribute('data-scrolled', !entry.isIntersecting),
      ).observe(sentinel);
    }
  </script>
)}

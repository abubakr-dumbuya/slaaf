---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { fetchCollection, formatPrice, SHOP } from '../lib/shop';
import huddle from '../assets/photos/huddle.jpg';

// Fetched at build time, so the homepage stays static and CDN-cached. Prices
// therefore refresh on deploy rather than on request — /apparel renders on
// demand and is the live figure if the two ever disagree.
const FEATURED = ['slaaf-american-football-hoodie', 'slaaf-american-football-sleeveless-hoodie'];
const all = (await fetchCollection()) ?? [];
const merch = FEATURED.map((handle) => all.find((p) => p.handle === handle)).filter((p) => p !== undefined);

const ways = [
  { title: 'Play', body: 'Combines, trials and national squads — flag and tackle, men and women.' },
  { title: 'Coach', body: 'Get certified and lead training in schools, clubs and communities.' },
  { title: 'Officiate', body: 'Train as a referee or official and run the game on match day.' },
  { title: 'Volunteer', body: 'Events, logistics, media, kit — everything that happens off the field.' },
];

const pillars = [
  {
    title: 'Grow the game at home',
    body: 'Introducing tackle and flag football to schools, universities and communities across Sierra Leone — coaching, equipment and safe places to play.',
  },
  {
    title: 'Build national teams',
    body: 'Selecting and preparing squads to represent Sierra Leone in international flag and tackle competition.',
  },
  {
    title: 'Govern the sport',
    body: 'Acting as the national governing body: registering clubs, certifying coaches and officials, and upholding player-safety standards.',
  },
];
---
<Base
  title="Sierra Leone Authority of American Football"
  description="Sierra Leone Authority of American Football (SLAAF) — the national governing body for tackle and flag football, building the game at home and across the diaspora."
  headerOverlay
>
  <!-- Hero. The photo fills the section and the copy sits over it, so the
       accent switches from atlantic blue to leone green: blue at this weight
       does not hold up against a dark photograph. -->
  <section class="relative isolate flex min-h-[30rem] flex-col overflow-hidden bg-ink-950 sm:min-h-[34rem] lg:min-h-[40rem]">
    <Image
      src={huddle}
      alt="SLAAF players and coaches in a huddle with hands raised, on a pitch in Freetown"
      widths={[640, 1024, 1536, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_18%]"
    />
    {/* Scrim, top only: enough to carry the white logo and nav, fading out
        below the header so the photograph reads as itself. */}
    <div class="absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-ink-950/88 via-ink-950/50 to-transparent"></div>

    {/* The band carries its own gradient rather than one sized in rem, so it
        tracks the headline's height at every breakpoint instead of being
        re-guessed whenever the type scale or the wording changes. */}
    <div class="mt-auto bg-gradient-to-t from-ink-950/92 via-ink-950/82 via-45% to-transparent pt-24">
      <div class="container-page pb-16 lg:pb-20">
        <h1 class="max-w-4xl text-4xl leading-[0.95] text-white [text-shadow:0_1px_3px_rgb(20_21_15/0.5)] lg:text-5xl">
          American Football
          <span class="mt-2 block">Has Arrived in <span class="text-leone-300">Sierra Leone</span></span>
        </h1>
      </div>
    </div>
  </section>

  <!-- Ways to get involved -->
  <section class="border-y border-ink-900/10 bg-sand-100">
    <div class="container-page py-20">
      <h2 class="text-3xl sm:text-4xl">Get involved</h2>

      {/* Sides and bottom are declared separately from the top so the green
          cap's width does not collide with the hairline border. */}
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ways.map((way) => (
          <li>
            <a
              href="/get-involved"
              class="group flex h-full flex-col rounded-2xl border-x border-b border-ink-900/10 border-t-4 border-t-leone-500 bg-sand-50 p-6 transition hover:border-t-atlantic-600 hover:bg-white"
            >
              <h3 class="text-xl transition group-hover:text-atlantic-600">{way.title}</h3>
              <p class="mt-2 mb-6 leading-relaxed text-ink-700">{way.body}</p>
              <span class="btn btn-primary mt-auto self-start text-base group-hover:bg-leone-600">
                Register
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Apparel collaboration -->
  <section>
    <div class="container-page py-20">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
        <div>
          <h2 class="text-3xl sm:text-4xl">SLAAF <span class="text-atlantic-600">&times;</span> FAMBUL</h2>
          <p class="prose-body mt-5">
            SLAAF has collaborated with <a href="https://by.fambul.com" class="text-leone-700 underline"
              target="_blank" rel="noopener noreferrer">FAMBUL</a> to produce an official collection for
            players and supporters.
          </p>
          <p class="mt-4 leading-relaxed text-ink-700">
            Every piece is available on presale now, with delivery expected in late 2026.
          </p>
        </div>

        <div>
          {merch.length > 0 && (
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
            {merch.map((product) => (
              <li>
                <a href="/apparel" class="group block">
                  {product.image && (
                    <div class="overflow-hidden rounded-2xl">
                      <img
                        src={product.image.src}
                        alt={product.title}
                        width={product.image.width}
                        height={product.image.height}
                        loading="lazy"
                        decoding="async"
                        class="aspect-square w-full object-cover mix-blend-multiply transition duration-300 group-hover:scale-[1.03]"
                      />
                    </div>
                  )}
                  <p class="type-label mt-3 text-ink-700">{product.title}</p>
                  <p class="type-label mt-1 text-ink-800">
                    {formatPrice(product.price, SHOP.currency)}
                  </p>
                  {product.blurb && (
                    <p class="mt-2 text-sm leading-relaxed text-ink-600">{product.blurb}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
          )}
          <a href="/apparel" class="btn btn-primary mt-8">See the full collection</a>
        </div>
      </div>
    </div>
  </section>
  <!-- What we do -->
  <section class="border-t border-ink-900/10 bg-sand-100">
    <div class="container-page py-20">
      <h2 class="text-3xl sm:text-4xl">What the Authority does</h2>
      <p class="prose-body mt-6">
        Sierra Leone Authority of American Football (SLAAF) is the national
        governing body for American football in Sierra Leone. We are building the
        game from the ground up — in schools and communities at home, and with
        Sierra Leonean talent wherever in the world it is found.
      </p>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {pillars.map((p, i) => (
          <div>
            <p class="type-numeral text-5xl text-leone-500/30">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-xl">{p.title}</h3>
            <p class="mt-3 text-ink-700 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>

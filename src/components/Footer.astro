---
import { Image } from 'astro:assets';
import logo from '../assets/slaaf-logo.png';

const year = new Date().getFullYear();
/** The federation's public address, also where registrations are delivered. */
const EMAIL = 'info@slaaf.org';
/** SLAAF's Instagram profile. */
const INSTAGRAM = 'https://www.instagram.com/salonegridiron/';

const columns = [
  { title: 'Football', links: [
    { href: '/get-involved', label: 'Get involved' },
    { href: '/events', label: 'Upcoming events' },
    { href: '/apparel', label: 'Apparel' },
  ]},
  { title: 'The Authority', links: [
    { href: '/about', label: 'About SLAAF' },
    { href: '/about#governance', label: 'Governance' },
    { href: `mailto:${EMAIL}`, label: 'Contact' },
  ]},
];
---
<footer class="bg-ink-950 text-sand-100">
  <div class="container-page py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1.2fr]">
      <div>
        <Image
          src={logo}
          alt="Sierra Leone Authority of American Football"
          height={48}
          densities={[1, 2]}
          class="h-11 w-auto brightness-0 invert"
        />
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-300">
          Sierra Leone Authority of American Football (SLAAF) — the national
          governing body for tackle and flag football in Sierra Leone.
        </p>
        <a
          href={INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 -ml-2 inline-flex rounded-full p-2 text-ink-300 transition hover:bg-white/10 hover:text-white"
        >
          {/* Labelled rather than relying on the glyph: the mark is decorative
              to a screen reader, so the accessible name lives on the link. */}
          <span class="sr-only">SLAAF on Instagram</span>
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-8">
        {columns.map((col) => (
          <div>
            <h2 class="type-label-xs text-leone-400">{col.title}</h2>
            <ul class="mt-4 space-y-2">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-ink-200 transition hover:text-white">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-6">
      <p class="text-xs text-ink-400">&copy; {year} Sierra Leone Authority of American Football. All rights reserved.</p>
    </div>
  </div>
</footer>

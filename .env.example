# Where player registrations are delivered.
# Set EITHER a webhook OR the Resend pair. With neither set, the registration
# endpoint returns 503 and /play shows a "not yet open" notice rather than
# accepting submissions it cannot store.

# Option A — POST each registration as JSON to a URL.
# A Google Apps Script bound to a Sheet works well here: it needs no service
# account, and the board reviews submissions in a tool they already use.
SLAAF_WEBHOOK_URL=

# Option B — email each registration to the federation.
RESEND_API_KEY=
SLAAF_NOTIFY_EMAIL=

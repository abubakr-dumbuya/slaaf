---
import { INTERESTS, INTEREST_PLAYING, CITIZENSHIP, RESIDENCY_COUNTRY_LABELS, SCHOOL_SPORT_LABELS, CONNECTIONS, BACKGROUNDS, SEXES, RESIDENCY, RESIDENCY_NONE, ENROLMENT, ENROLMENT_NONE, SCHOOL_SPORT, POSITION_GROUPS, MIN_AGE } from '../lib/registration';
import { COUNTRY_OPTIONS } from '../lib/countries';

const field = 'w-full rounded-lg border-2 border-ink-900/15 bg-white px-4 py-3 text-ink-900 transition placeholder:text-ink-400 focus:border-leone-500 focus:outline-none';
const label = 'block type-control text-ink-800';
const err = 'mt-1 text-sm font-medium text-red-700';
---
<datalist id="country-list">
  {COUNTRY_OPTIONS.map((c) => <option value={c}></option>)}
</datalist>

<form id="registration" method="POST" action="/api/register" novalidate class="mt-10 scroll-mt-28 space-y-8">
  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <fieldset class="space-y-6">
    <legend class="type-title text-xl">About you</legend>

    <div>
      <span class={label}>I am interested in <span class="font-normal normal-case text-ink-500">(select all that apply)</span></span>
      <div class="mt-3 flex flex-wrap gap-3">
        {INTERESTS.map((i) => (
          <label class="flex cursor-pointer items-center gap-2 rounded-full border-2 border-ink-900/15 bg-white px-4 py-2 transition has-[:checked]:border-leone-500 has-[:checked]:bg-leone-50">
            <input type="checkbox" name="interests" data-playing={INTEREST_PLAYING} value={i} class="accent-leone-600" />
            <span class="type-control">{i}</span>
          </label>
        ))}
      </div>
      <p class={err} data-error="interests" hidden></p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class={label} for="firstName">First name</label>
        <input class={`${field} mt-2`} id="firstName" name="firstName" type="text" autocomplete="given-name" required />
        <p class={err} data-error="firstName" hidden></p>
      </div>

      <div>
        <label class={label} for="lastName">Last name</label>
        <input class={`${field} mt-2`} id="lastName" name="lastName" type="text" autocomplete="family-name" required />
        <p class={err} data-error="lastName" hidden></p>
      </div>
      <div>
        <label class={label} for="email">Email</label>
        <input class={`${field} mt-2`} id="email" name="email" type="email" autocomplete="email" required />
        <p class={err} data-error="email" hidden></p>
      </div>
      <div>
        <label class={label} for="phone">Phone or WhatsApp <span class="font-normal normal-case text-ink-500">(optional)</span></label>
        <input class={`${field} mt-2`} id="phone" name="phone" type="tel" autocomplete="tel" />
        <p class={err} data-error="phone" hidden></p>
      </div>
      <div>
        <label class={label} for="country">Country where you live</label>
        <input class={`${field} mt-2`} id="country" name="country" type="text" list="country-list"
               autocomplete="country-name" placeholder="Start typing…" required />
        <p class={err} data-error="country" hidden></p>
      </div>
      <div>
        <label class={label} for="sex">Sex</label>
        <select class={`${field} mt-2`} id="sex" name="sex" required aria-describedby="sex-help">
          <option value="">Choose one…</option>
          {SEXES.map((g) => <option value={g}>{g}</option>)}
        </select>
        <p id="sex-help" class="mt-1 text-sm text-ink-500">Used to determine your competition category.</p>
        <p class={err} data-error="sex" hidden></p>
      </div>
      <div>
        <label class={label} for="dateOfBirth">Date of birth</label>
        <input class={`${field} mt-2`} id="dateOfBirth" name="dateOfBirth" type="date" required
               aria-describedby="dob-help" />
        <p id="dob-help" class="mt-1 text-sm text-ink-500">You must be at least {MIN_AGE} to register.</p>
        <p class={err} data-error="dateOfBirth" hidden></p>
      </div>
    </div>
  </fieldset>

  <!-- Revealed only when the date of birth indicates the applicant is under 18. -->
  <fieldset id="guardian" hidden class="rounded-xl border-2 border-atlantic-600/30 bg-atlantic-50 p-6">
    <legend class="float-left mb-4 w-full type-title text-xl">
      Parent or guardian
    </legend>
    <p class="mb-6 text-ink-700">
      Because you are under 18, we need a parent or guardian on the record before
      you can take part.
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class={label} for="guardianName">Parent or guardian name</label>
        <input class={`${field} mt-2`} id="guardianName" name="guardianName" type="text" autocomplete="off" />
        <p class={err} data-error="guardianName" hidden></p>
      </div>
      <div>
        <label class={label} for="guardianPhone">Their phone number</label>
        <input class={`${field} mt-2`} id="guardianPhone" name="guardianPhone" type="tel" autocomplete="off" />
        <p class={err} data-error="guardianPhone" hidden></p>
      </div>
      <div class="sm:col-span-2 lg:col-span-1">
        <label class={label} for="guardianEmail">Their email <span class="font-normal normal-case text-ink-500">(optional)</span></label>
        <input class={`${field} mt-2`} id="guardianEmail" name="guardianEmail" type="email" autocomplete="off" />
        <p class={err} data-error="guardianEmail" hidden></p>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-6">
    <legend class="type-title text-xl">Your connection and background</legend>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class={label} for="connection">Connection to Sierra Leone</label>
        <select class={`${field} mt-2`} id="connection" name="connection" required>
          <option value="">Choose one…</option>
          {CONNECTIONS.map((c) => <option value={c}>{c}</option>)}
        </select>
        <p class={err} data-error="connection" hidden></p>
      </div>
      <div>
        <label class={label} for="citizenship">Are you a Sierra Leone citizen?</label>
        <select class={`${field} mt-2`} id="citizenship" name="citizenship" required>
          <option value="">Choose one…</option>
          {CITIZENSHIP.map((c) => <option value={c}>{c}</option>)}
        </select>
        <p class={err} data-error="citizenship" hidden></p>
      </div>

      <div>
        <label class={label} for="residency">Citizenship or residency outside of Sierra Leone</label>
        <select class={`${field} mt-2`} id="residency" name="residency" required data-none={RESIDENCY_NONE}>
          <option value="" data-option-label={RESIDENCY_COUNTRY_LABELS['']}>Choose one…</option>
          {RESIDENCY.map((r) => (
            <option value={r} data-option-label={RESIDENCY_COUNTRY_LABELS[r]}>{r}</option>
          ))}
        </select>
        <p class={err} data-error="residency" hidden></p>
      </div>

      <div id="residency-country-wrap" class="opacity-50 transition-opacity">
        <label class={label} for="residencyCountry" id="residencyCountry-label">{RESIDENCY_COUNTRY_LABELS['']}</label>
        <input
          class={`${field} mt-2 disabled:cursor-not-allowed disabled:border-ink-900/10 disabled:bg-sand-100 disabled:text-ink-400`}
          id="residencyCountry" name="residencyCountry" type="text" list="country-list"
          autocomplete="off" placeholder="Start typing…" disabled
        />
        <p class={err} data-error="residencyCountry" hidden></p>
      </div>

      <div>
        <label class={label} for="enrolment">Are you in high school or college?</label>
        <select class={`${field} mt-2`} id="enrolment" name="enrolment" required data-none={ENROLMENT_NONE}>
          <option value="" data-option-label={SCHOOL_SPORT_LABELS['']}>Choose one…</option>
          {ENROLMENT.map((e) => <option value={e} data-option-label={SCHOOL_SPORT_LABELS[e]}>{e}</option>)}
        </select>
        <p class={err} data-error="enrolment" hidden></p>
      </div>

      <div id="school-sport-wrap" class="opacity-50 transition-opacity">
        <label class={label} for="schoolSport" id="schoolSport-label">{SCHOOL_SPORT_LABELS['']}</label>
        <select
          class={`${field} mt-2 disabled:cursor-not-allowed disabled:border-ink-900/10 disabled:bg-sand-100 disabled:text-ink-400`}
          id="schoolSport" name="schoolSport" disabled
        >
          <option value="">Choose one…</option>
          {SCHOOL_SPORT.map((o) => <option value={o}>{o}</option>)}
        </select>
        <p class={err} data-error="schoolSport" hidden></p>
      </div>

      <div>
        <label class={label} for="background">Main sporting background</label>
        <select class={`${field} mt-2`} id="background" name="background" required>
          <option value="">Choose one…</option>
          {BACKGROUNDS.map((b) => <option value={b}>{b}</option>)}
        </select>
        <p class={err} data-error="background" hidden></p>
      </div>

      {/* Revealed only when "Playing" is among the chosen interests. */}
      <div id="position-wrap" hidden>
        <label class={label} for="position">Position you play <span class="font-normal normal-case text-ink-500">(optional)</span></label>
        <select class={`${field} mt-2`} id="position" name="position">
          <option value="">Choose one…</option>
          {POSITION_GROUPS.map((group) => (
            <optgroup label={group.label}>
              {group.options.map((o) => <option value={o}>{o}</option>)}
            </optgroup>
          ))}
        </select>
        <p class={err} data-error="position" hidden></p>
      </div>
    </div>

    <div class="max-w-3xl">
      <label class={label} for="experience">Prior experience <span class="font-normal normal-case text-ink-500">(optional)</span></label>
      <textarea class={`${field} mt-2`} id="experience" name="experience" rows="4"
                placeholder="Teams, leagues, school or college programmes, years played…"></textarea>
    </div>

    <div class="max-w-3xl">
      <label class={label} for="filmUrl">Link to highlight film <span class="font-normal normal-case text-ink-500">(optional)</span></label>
      <input class={`${field} mt-2`} id="filmUrl" name="filmUrl" type="url" placeholder="https://…"
             aria-describedby="film-help" />
      <p id="film-help" class="mt-1 text-sm text-ink-500">A YouTube, Hudl or Drive link. Please do not attach video files.</p>
      <p class={err} data-error="filmUrl" hidden></p>
    </div>
  </fieldset>

  <div class="max-w-3xl rounded-xl bg-sand-100 p-6">
    <label class="flex cursor-pointer items-start gap-3">
      <input type="checkbox" name="consent" id="consent" class="mt-1 h-5 w-5 shrink-0 accent-leone-600" required />
      <span class="text-ink-700">
        I agree that SLAAF may hold these details in order to contact me about
        playing, coaching, officiating or volunteering. I can ask for my details
        to be removed at any time.
      </span>
    </label>
    <p class={err} data-error="consent" hidden></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary" data-submit>Send my registration</button>
    <p class="text-sm text-ink-500" data-status role="status" aria-live="polite"></p>
  </div>

  <p class="text-sm font-medium text-red-700" data-error="form" hidden></p>
</form>

<dialog
  id="missing-fields"
  class="w-[min(92vw,32rem)] rounded-2xl border-2 border-ink-900/15 bg-white p-0 text-ink-900 backdrop:bg-ink-950/50"
>
  <div class="p-7">
    <h2 class="text-2xl">Some details are missing</h2>
    <p class="mt-3 text-ink-700">Please fill these in before sending your registration:</p>
    <ul id="missing-fields-list" class="mt-5 space-y-2"></ul>
    <button type="button" class="btn btn-primary mt-7 w-full" data-close-missing>
      Back to the form
    </button>
  </div>
</dialog>

<div id="registration-success" hidden class="mt-10 rounded-xl border-2 border-leone-500 bg-leone-50 p-8">
  <h2 class="text-2xl">Thank you — we have your registration.</h2>
  <p class="prose-body mt-3">
    Someone from SLAAF will be in touch. Keep an eye on your inbox, and check
    your spam folder if you do not hear from us.
  </p>
</div>

<script>
  const form = document.getElementById('registration') as HTMLFormElement | null;
  const success = document.getElementById('registration-success');
  if (form && success) {
    const guardian = document.getElementById('guardian') as HTMLFieldSetElement;
    const dob = form.querySelector<HTMLInputElement>('#dateOfBirth')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    const dialog = document.getElementById('missing-fields') as HTMLDialogElement;
    const dialogList = document.getElementById('missing-fields-list')!;
    dialog
      .querySelector('[data-close-missing]')!
      .addEventListener('click', () => dialog.close());

    /**
     * Field names mean nothing to a person, so the popup lists the labels they
     * actually saw. Read from the DOM where a label exists so the two cannot
     * drift, with a fallback for controls that have no `for` target.
     */
    const FALLBACK_LABELS: Record<string, string> = {
      interests: 'What you are interested in',
      consent: 'Consent to hold your details',
      form: 'Something went wrong',
    };
    const labelFor = (key: string): string => {
      const el = form.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(key)}"]`);
      if (el) {
        // Drop the "(optional)" suffix and collapse whitespace.
        return el.textContent!.replace(/\(optional\)/i, '').replace(/\s+/g, ' ').trim();
      }
      return FALLBACK_LABELS[key] ?? key;
    };

    const clearErrors = () =>
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });

    const showErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [key, message] of Object.entries(errors)) {
        const el = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
        if (!el) continue;
        el.textContent = message;
        el.hidden = false;
        first ??= form.querySelector<HTMLElement>(`#${CSS.escape(key)}`) ?? el;
      }
      first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      (first as HTMLInputElement | null)?.focus?.();
    };

    const showMissingDialog = (errors: Record<string, string>) => {
      dialogList.replaceChildren(
        ...Object.entries(errors).map(([key, message]) => {
          const li = document.createElement('li');
          li.className = 'flex gap-3 text-ink-800';
          const dot = document.createElement('span');
          dot.className = 'mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-leone-500';
          dot.setAttribute('aria-hidden', 'true');
          const text = document.createElement('span');
          const name = document.createElement('strong');
          name.className = 'type-control';
          name.textContent = labelFor(key);
          text.append(name, document.createTextNode(` — ${message}`));
          li.append(dot, text);
          return li;
        }),
      );
      dialog.showModal();
    };

    // Reveal the guardian block as soon as the date of birth says under 18.
    const syncGuardian = () => {
      const value = dob.valueAsDate;
      if (!value) return;
      const now = new Date();
      let age = now.getFullYear() - value.getFullYear();
      const m = now.getMonth() - value.getMonth();
      if (m < 0 || (m === 0 && now.getDate() < value.getDate())) age--;
      guardian.hidden = !(age >= 0 && age < 18);
    };
    dob.addEventListener('change', syncGuardian);
    syncGuardian();

    const residency = form.querySelector<HTMLSelectElement>('#residency')!;
    const residencyWrap = document.getElementById('residency-country-wrap') as HTMLElement;
    const NONE = residency.dataset.none;
    const residencyCountry = form.querySelector<HTMLInputElement>('#residencyCountry')!;
    /** Rewrites a dependent field's label to match the option just chosen. */
    const syncLabel = (select: HTMLSelectElement, targetId: string) => {
      const wording = select.selectedOptions[0]?.dataset.optionLabel;
      const target = document.getElementById(targetId);
      if (target && wording) target.textContent = wording;
    };
    const syncResidency = () => {
      const applies = residency.value !== '' && residency.value !== NONE;
      residencyCountry.disabled = !applies;
      residencyWrap.classList.toggle('opacity-50', !applies);
      // Every option carries its own wording, so no fallback is needed here.
      syncLabel(residency, 'residencyCountry-label');
      // Do not leave a stale country behind when the answer changes back.
      if (!applies) residencyCountry.value = '';
    };
    residency.addEventListener('change', syncResidency);
    syncResidency();

    // Same shape as the residency pair: the follow-up only applies to those
    // still in education, and must not carry a stale answer if that changes.
    const enrolment = form.querySelector<HTMLSelectElement>('#enrolment')!;
    const schoolSportWrap = document.getElementById('school-sport-wrap') as HTMLElement;
    const NO_SCHOOL = enrolment.dataset.none;
    const schoolSport = form.querySelector<HTMLSelectElement>('#schoolSport')!;
    const syncEnrolment = () => {
      const applies = enrolment.value !== '' && enrolment.value !== NO_SCHOOL;
      schoolSport.disabled = !applies;
      schoolSport.required = applies;
      schoolSportWrap.classList.toggle('opacity-50', !applies);
      syncLabel(enrolment, 'schoolSport-label');
      if (!applies) schoolSport.value = '';
    };
    enrolment.addEventListener('change', syncEnrolment);
    syncEnrolment();

    // The position question is meaningless for a coach or volunteer, so it is
    // removed rather than dimmed, and never carries an answer that the server
    // would then reject.
    const interests = [...form.querySelectorAll<HTMLInputElement>('input[name="interests"]')];
    const positionWrap = document.getElementById('position-wrap') as HTMLElement;
    const position = form.querySelector<HTMLSelectElement>('#position')!;
    const PLAYING = interests[0]?.dataset.playing;
    const syncPosition = () => {
      const plays = interests.some((i) => i.checked && i.value === PLAYING);
      positionWrap.hidden = !plays;
      if (!plays) position.value = '';
    };
    interests.forEach((i) => i.addEventListener('change', syncPosition));
    syncPosition();

    // The homepage cards link here with the interest they represent. Applied
    // after the listeners above are attached, so the change event it fires
    // reaches them and reveals the position question when relevant.
    const wanted = new URLSearchParams(location.search).get('interest');
    if (wanted) {
      const box = interests.find((i) => i.value === wanted);
      if (box) {
        box.checked = true;
        box.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      submit.disabled = true;
      status.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.hidden = true;
          success.hidden = false;
          success.scrollIntoView({ block: 'center', behavior: 'smooth' });
          return;
        }
        status.textContent = '';
        if (data.errors) {
          showMissingDialog(data.errors);
          dialog.addEventListener('close', () => showErrors(data.errors), { once: true });
        } else {
          showErrors({ form: data.message ?? 'Something went wrong. Please try again.' });
        }
      } catch {
        status.textContent = '';
        showErrors({ form: 'We could not reach the server. Please check your connection and try again.' });
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

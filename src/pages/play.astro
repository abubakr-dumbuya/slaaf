---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import RegistrationForm from '../components/RegistrationForm.astro';

// Written once. Shown under the lede on mobile and tablet, and in the sidebar
// from lg up, where there is a column to hold it.
const whoCanRegister = [
  "Anyone aged 15 or over with a connection to Sierra Leone — by birth, through a parent or grandparent, or otherwise — wherever in the world you live. You do not need to have played American football before. Athletes from football, athletics, basketball and rugby backgrounds are all part of how the game grows here.",
  "If you are under 18, we will ask for a parent or guardian's details before you can take part.",
];

---
<Base
  title="Play for Salone"
  description="Register your interest in playing, coaching, officiating or volunteering with the Sierra Leone Authority of American Football — open to Sierra Leoneans at home and anywhere in the world."
>
  <PageHeader
    title="Play for Salone"
    lede="We are building Sierra Leone's national football programme from the ground up — and we are looking for players, coaches, officials and volunteers, at home and across the diaspora."
  >
    <div class="mt-6 max-w-2xl space-y-4">
      {whoCanRegister.map((para) => <p class="leading-relaxed text-ink-700">{para}</p>)}
    </div>
    <p class="mt-6 max-w-2xl leading-relaxed text-ink-700">
      Registrations go onto SLAAF's athlete database, which is how we select for
      combines, training sessions and, in time, national squads. We will be in
      touch by email — so please use an address you check.
    </p>
  </PageHeader>

  <section class="container-page py-16">
    <h2 class="text-3xl sm:text-4xl">Register your interest</h2>
    <p class="prose-body mt-5 max-w-2xl">
      Fill this in and it comes straight to SLAAF. There is no commitment at this
      stage — it tells us who you are, where you are and what you want to do, so
      we can contact you as programmes, camps and trials are scheduled.
    </p>


    <RegistrationForm />
  </section>

  <Placeholder need="Still to confirm for this page: eligibility rules for heritage players and any documentation required, the calendar of combines and trials, the positions being actively recruited, and where registration data should be delivered (the form is built but not yet connected to a destination)." />
</Base>

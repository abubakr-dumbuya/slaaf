---
interface Props { title: string; lede?: string; }
const { title, lede } = Astro.props;
---
<section class="border-b border-ink-900/10 bg-sand-100">
  <div class="container-page py-16 sm:py-20">
    <h1 class="text-4xl sm:text-6xl">{title}</h1>
    {lede && <p class="prose-body mt-6">{lede}</p>}
    <slot />
  </div>
</section>

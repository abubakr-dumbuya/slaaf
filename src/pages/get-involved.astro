---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RegistrationForm from '../components/RegistrationForm.astro';

const notes = [
  "We need players, coaches, officials and volunteers — in Sierra Leone and across the diaspora.",
  "Open to anyone 15 or over with a connection to Sierra Leone — by birth, or through a parent or grandparent — wherever you live.",
  "No experience of American football needed.",
  "Under 18s will need a parent or guardian's details.",
  "Registrations go onto SLAAF's database: how we select for combines, training and squads, and how we staff events. We reply by email.",
];

---
<Base
  title="Get involved"
  description="Play, coach, officiate or volunteer with the Sierra Leone Authority of American Football — open to Sierra Leoneans at home and anywhere in the world."
>
  <PageHeader title="Get involved">
    {/* Two CSS columns rather than a grid, so the list still reads top to
        bottom down the first column before continuing in the second. */}
    <ul class="mt-8 list-disc space-y-3 pl-5 marker:text-leone-500 md:columns-2 md:gap-12 md:space-y-0">
      {notes.map((note) => (
        <li class="mb-3 break-inside-avoid leading-relaxed text-ink-700">{note}</li>
      ))}
    </ul>
  </PageHeader>

  <section class="container-page py-16">
    <h2 class="text-3xl sm:text-4xl">Register your interest</h2>
    <p class="prose-body mt-5 max-w-2xl">
      No commitment at this stage — it just tells us who you are and what you
      want to do.
    </p>


    <RegistrationForm />
  </section>

</Base>
